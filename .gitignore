# ==============================================================================
# FinWise - Git Ignore Configuration
# Protects secrets, virtual environments, cache files, and IDE configurations.
# ==============================================================================

# 1. Environment Variables & Secrets (CRITICAL: Never commit credentials)
.env
.env.*
!.env.example
.flaskenv
*.env

# 2. Virtual Environment
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# 3. Python Bytecode & Cache Files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# 4. IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
.gemini/
.agents/

# 5. Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
